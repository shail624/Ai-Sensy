  "version": "1.0.0-rc1",
  "type": "module",
  "description": "Self-Hosted WhatsApp Business Platform — Frontend (Vi Reactivation Team)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
