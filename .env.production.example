# Production environment template.
#
#   cp .env.production.example .env.production   # then fill in every value marked REQUIRED
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d
#
# NEVER commit the filled-in file. `.dockerignore` and `.gitignore` already exclude `.env*`
# (with an `!.env.example` carve-out), but the safest home for these is your orchestrator's
# secret store, injected as environment variables at run time (Doc 08 §20).
#
# Compose fails fast on a missing REQUIRED value: the manifest declares them as `${VAR:?}`, so
# `up` aborts with the variable name rather than starting a half-configured stack.

# ---- Image tag ------------------------------------------------------------------------------
# Pin to an immutable tag per release so a rollback is a tag change, not a rebuild.
IMAGE_TAG=1.0.0-rc1

# ---- Edge -------------------------------------------------------------------------------------
HTTP_PORT=80
# Empty = the SPA calls the API on its own origin through the edge proxy. Set only when the API
# is served from a different origin. Compiled into the bundle at BUILD time, not read at runtime.
VITE_API_BASE_URL=
# Comma-separated browser origins allowed to call the API. Leave empty for same-origin.
CORS_ORIGINS=

# ---- Security (REQUIRED) ------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this invalidates every access and refresh token — all users must sign in again.
SECRET_KEY=

# 32-byte base64url key encrypting WhatsApp access tokens at rest (Doc 03 §5.1, FR-WA-03).
# Generate: python -c "from app.core.crypto import generate_key; print(generate_key())"
#   (or: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
#
# REQUIRED. In production the application refuses to derive this from SECRET_KEY, so leaving it
# empty does not fall back — it makes the WhatsApp integration inert: registering a WABA fails and
# already-stored tokens cannot be decrypted, so nothing sends.
#
# Rotating it does NOT re-encrypt existing rows; stored tokens become unreadable and must be
# re-entered. Back it up wherever you back up SECRET_KEY.
TOKEN_ENCRYPTION_KEY=

# ---- Database (REQUIRED) ------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
DB_NAME=wa_platform
DB_USER=wa_app
DB_PASSWORD=
MYSQL_MAX_CONNECTIONS=300

# ---- Redis (REQUIRED) ---------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use a URL-safe value (letters, digits, - and _). This password is interpolated into REDIS_URL as
# `redis://:<password>@redis:6379/0`, so a `@`, `/` or `:` in it corrupts the connection string.
#
# No Redis port is published, but the password is not optional: Redis is the broker, the cache and
# the rate gate, and an unauthenticated instance reachable from anywhere on the host's bridge
# network is a remote-code-execution primitive, not just a data-exposure one.
REDIS_PASSWORD=

# ---- Meta Cloud API (REQUIRED) --------------------------------------------------------------------
# From the Meta app dashboard. APP_SECRET verifies inbound webhook signatures — a wrong value
# means every webhook is rejected and no message is ever received.
META_APP_SECRET=
# The token you enter in Meta's webhook configuration screen; must match exactly.
META_WEBHOOK_VERIFY_TOKEN=

# ---- WAHA QR provider (OPTIONAL; REQUIRED together when --profile waha is enabled) ----------------
# Internal service address only. WAHA is never reverse-proxied or published by production Compose.
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION_NAME=waha
# Generate a dedicated value. Never reuse META_WEBHOOK_VERIFY_TOKEN, META_APP_SECRET, WAHA_API_KEY,
# or any session credential. The same value is injected into WAHA's sender and the backend verifier.
WAHA_WEBHOOK_HMAC_SECRET=
# The one organization authorized by ADR-0021's internal single-organization scope.
WAHA_ORGANIZATION_ID=

# ---- Storage --------------------------------------------------------------------------------------
# 'local' writes to the media-data volume. Back this volume up: it holds inbound media and every
# generated export artifact.
STORAGE_BACKEND=local
STORAGE_EXPORT_TTL_DAYS=7

# ---- Scaling ----------------------------------------------------------------------------------------
# uvicorn processes per API container.
API_WORKERS=2
# Celery concurrency per worker pool. Realtime stays low to stay responsive; bulk carries volume.
WORKER_REALTIME_CONCURRENCY=4
WORKER_BULK_CONCURRENCY=8
WORKER_JOBS_CONCURRENCY=4

# ---- Logging ------------------------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---- API reference -------------------------------------------------------------------------------------
# `/docs`, `/redoc` and the OpenAPI schema. Off in production by default: no endpoint is reachable
# without a token, so serving them is a map rather than a breach — but it is every path, payload and
# enum of a private operations platform, handed to anyone who asks. Set true to publish a reference
# for integrators deliberately. Unset behaves as false in production.
# API_DOCS_ENABLED=false

# ---- Bootstrap (first deploy only; do not leave populated) -------------------------------------------
# Used once by the `bootstrap` Compose profile to create the first organization and owner:
#   docker compose -f docker-compose.production.yml --env-file .env.production \
#     --profile bootstrap run --rm bootstrap
# Only the `bootstrap` service receives these; the api/worker/beat containers deliberately
# never see OWNER_PASSWORD. Clear them once the owner exists — the stack starts fine without.
# BOOTSTRAP_ORG_NAME="Vi Reactivation Team"
# BOOTSTRAP_ORG_SLUG=vi-reactivation
# OWNER_EMAIL=
# OWNER_FULL_NAME=
# OWNER_PASSWORD=
