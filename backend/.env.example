# Backend environment template (copy to .env for local development).
# Never commit real secrets. Production values come from the secret store (Doc 08 §20).

# ---- Application ----
APP_NAME="WhatsApp Business Platform"
ENVIRONMENT=development           # development | staging | production | test
DEBUG=true

# ---- Security / JWT (Doc 04 §4) ----
# Generate a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=change-me-in-production-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Password policy & Argon2id (Doc 01 §5.4 / FR-AUTH-04) ----
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536          # KiB (64 MiB)
ARGON2_PARALLELISM=4

# ---- Rate limiting (Doc 04 §9) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300

# ---- Database (MySQL 8, async) ----
# Either set DATABASE_URL directly or the discrete DB_* parts below.
# DATABASE_URL=mysql+asyncmy://wa_app:wa_app@localhost:3306/wa_platform?charset=utf8mb4
DB_HOST=localhost
DB_PORT=3306
DB_USER=wa_app
DB_PASSWORD=wa_app
DB_NAME=wa_platform

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- CORS (comma-separated) ----
CORS_ORIGINS=http://localhost:5173

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Bootstrap (owner user; see `python -m app.cli create-owner`) ----
BOOTSTRAP_ORG_NAME="Vi Reactivation Team"
BOOTSTRAP_ORG_SLUG=vi-reactivation
# Provided at bootstrap time only (never committed):
# OWNER_EMAIL=owner@company.com
# OWNER_FULL_NAME="Owner"
# OWNER_PASSWORD=change-me-strong-password
