# Root environment template for docker-compose (copy to .env).
# These values seed the local MySQL/Redis containers; the backend reads its own
# backend/.env. Keep the credentials in sync between this file and backend/.env.

MYSQL_ROOT_PASSWORD=root
DB_NAME=wa_platform
DB_USER=wa_app
DB_PASSWORD=wa_app
DB_PORT=3306
REDIS_PORT=6379

# Optional local WAHA profile. Keep the HMAC value identical in backend/.env; it is dedicated to
# WAHA webhook signing and must never reuse a Meta token or app secret.
WAHA_API_KEY=waha-local-dev-key
WAHA_WEBHOOK_HMAC_SECRET=waha-local-dev-webhook-hmac
