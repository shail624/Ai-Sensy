# Root environment template for docker-compose (copy to .env).
# These values seed the local MySQL/Redis containers; the backend reads its own
# backend/.env. Keep the credentials in sync between this file and backend/.env.

MYSQL_ROOT_PASSWORD=root
DB_NAME=wa_platform
DB_USER=wa_app
DB_PASSWORD=wa_app
DB_PORT=3306
REDIS_PORT=6379
